#############################################
# Utility command for package

build src/compression/CMakeFiles/package.util: CUSTOM_COMMAND src/compression/all
  COMMAND = cd /work/MilkyTrackerNX2/build_nx2 && /usr/bin/cpack --config ./CPackConfig.cmake
  DESC = Run CPack packaging tool...
  pool = console
  restat = 1

build src/compression/package: phony src/compression/CMakeFiles/package.util


#############################################
# Utility command for package_source

build src/compression/CMakeFiles/package_source.util: CUSTOM_COMMAND
  COMMAND = cd /work/MilkyTrackerNX2/build_nx2 && /usr/bin/cpack --config ./CPackSourceConfig.cmake /work/MilkyTrackerNX2/build_nx2/CPackSourceConfig.cmake
  DESC = Run CPack packaging tool for source...
  pool = console
  restat = 1

build src/compression/package_source: phony src/compression/CMakeFiles/package_source.util


#############################################
# Utility command for edit_cache

build src/compression/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /work/MilkyTrackerNX2/build_nx2/src/compression && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build src/compression/edit_cache: phony src/compression/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build src/compression/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /work/MilkyTrackerNX2/build_nx2/src/compression && /usr/bin/cmake --regenerate-during-build -S/work/MilkyTrackerNX2 -B/work/MilkyTrackerNX2/build_nx2
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build src/compression/rebuild_cache: phony src/compression/CMakeFiles/rebuild_cache.util


#############################################
# Utility command for list_install_components

build src/compression/list_install_components: phony


#############################################
# Utility command for install

build src/compression/CMakeFiles/install.util: CUSTOM_COMMAND src/compression/all
  COMMAND = cd /work/MilkyTrackerNX2/build_nx2/src/compression && /usr/bin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build src/compression/install: phony src/compression/CMakeFiles/install.util


#############################################
# Utility command for install/local

build src/compression/CMakeFiles/install/local.util: CUSTOM_COMMAND src/compression/all
  COMMAND = cd /work/MilkyTrackerNX2/build_nx2/src/compression && /usr/bin/cmake -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake
  DESC = Installing only the local directory...
  pool = console
  restat = 1

build src/compression/install/local: phony src/compression/CMakeFiles/install/local.util


#############################################
# Utility command for install/strip

build src/compression/CMakeFiles/install/strip.util: CUSTOM_COMMAND src/compression/all
  COMMAND = cd /work/MilkyTrackerNX2/build_nx2/src/compression && /usr/bin/cmake -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake
  DESC = Installing the project stripped...
  pool = console
  restat = 1

build src/compression/install/strip: phony src/compression/CMakeFiles/install/strip.util

