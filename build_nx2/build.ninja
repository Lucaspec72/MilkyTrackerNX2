# Link the static library src/fx/libfx.a

build src/fx/libfx.a: CXX_STATIC_LIBRARY_LINKER__fx_Release src/fx/CMakeFiles/fx.dir/Camera.o src/fx/CMakeFiles/fx.dir/Filter.o src/fx/CMakeFiles/fx.dir/Fire.o src/fx/CMakeFiles/fx.dir/Math3d.o src/fx/CMakeFiles/fx.dir/ParticleBlobs.o src/fx/CMakeFiles/fx.dir/ParticleEmitter.o src/fx/CMakeFiles/fx.dir/ParticleFX.o src/fx/CMakeFiles/fx.dir/ParticleFun.o src/fx/CMakeFiles/fx.dir/ParticleScene.o src/fx/CMakeFiles/fx.dir/Starfield.o src/fx/CMakeFiles/fx.dir/TCBSpline.o src/fx/CMakeFiles/fx.dir/TCBSplineTest.o src/fx/CMakeFiles/fx.dir/Texture.o src/fx/CMakeFiles/fx.dir/TexturedGrid.o src/fx/CMakeFiles/fx.dir/TexturedPlane.o src/fx/CMakeFiles/fx.dir/Twister.o src/fx/CMakeFiles/fx.dir/TwisterFX.o src/fx/CMakeFiles/fx.dir/fpmath.o
  LANGUAGE_COMPILE_FLAGS = -mcpu=cortex-a78c+crypto -mtp=soft -fPIC -ftls-model=local-exec -O2 -ffunction-sections -fdata-sections -mcpu=cortex-a78c+crypto -mtp=soft -ftls-model=local-exec -ffunction-sections -fdata-sections -D__SWITCH__ -D__SWITCH2__ -g -O2 -DNDEBUG
  OBJECT_DIR = src/fx/CMakeFiles/fx.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_FILE = src/fx/libfx.a
  TARGET_PDB = fx.a.dbg


#############################################
# Utility command for package

build src/fx/CMakeFiles/package.util: CUSTOM_COMMAND src/fx/all
  COMMAND = cd /work/MilkyTrackerNX2/build_nx2 && /usr/bin/cpack --config ./CPackConfig.cmake
  DESC = Run CPack packaging tool...
  pool = console
  restat = 1

build src/fx/package: phony src/fx/CMakeFiles/package.util


#############################################
# Utility command for package_source

build src/fx/CMakeFiles/package_source.util: CUSTOM_COMMAND
  COMMAND = cd /work/MilkyTrackerNX2/build_nx2 && /usr/bin/cpack --config ./CPackSourceConfig.cmake /work/MilkyTrackerNX2/build_nx2/CPackSourceConfig.cmake
  DESC = Run CPack packaging tool for source...
  pool = console
  restat = 1

build src/fx/package_source: phony src/fx/CMakeFiles/package_source.util


#############################################
# Utility command for edit_cache

build src/fx/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /work/MilkyTrackerNX2/build_nx2/src/fx && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build src/fx/edit_cache: phony src/fx/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build src/fx/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /work/MilkyTrackerNX2/build_nx2/src/fx && /usr/bin/cmake --regenerate-during-build -S/work/MilkyTrackerNX2 -B/work/MilkyTrackerNX2/build_nx2
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build src/fx/rebuild_cache: phony src/fx/CMakeFiles/rebuild_cache.util


#############################################
# Utility command for list_install_components

build src/fx/list_install_components: phony


#############################################
# Utility command for install

build src/fx/CMakeFiles/install.util: CUSTOM_COMMAND src/fx/all
  COMMAND = cd /work/MilkyTrackerNX2/build_nx2/src/fx && /usr/bin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build src/fx/install: phony src/fx/CMakeFiles/install.util


#############################################
# Utility command for install/local

build src/fx/CMakeFiles/install/local.util: CUSTOM_COMMAND src/fx/all
  COMMAND = cd /work/MilkyTrackerNX2/build_nx2/src/fx && /usr/bin/cmake -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake
  DESC = Installing only the local directory...
  pool = console
  restat = 1

build src/fx/install/local: phony src/fx/CMakeFiles/install/local.util


#############################################
# Utility command for install/strip

build src/fx/CMakeFiles/install/strip.util: CUSTOM_COMMAND src/fx/all
  COMMAND = cd /work/MilkyTrackerNX2/build_nx2/src/fx && /usr/bin/cmake -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake
  DESC = Installing the project stripped...
  pool = console
  restat = 1

build src/fx/install/strip: phony src/fx/CMakeFiles/install/strip.util

