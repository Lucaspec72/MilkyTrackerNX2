build src/milkyplay/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /work/MilkyTrackerNX2/build_nx2/src/milkyplay && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build src/milkyplay/edit_cache: phony src/milkyplay/CMakeFiles/edit_cache.util


