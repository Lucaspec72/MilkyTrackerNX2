#############################################
# Utility command for package

build src/milkyplay/CMakeFiles/package.util: CUSTOM_COMMAND src/milkyplay/all
  COMMAND = cd /work/MilkyTrackerNX2/build_nx2 && /usr/bin/cpack --config ./CPackConfig.cmake
  DESC = Run CPack packaging tool...
  pool = console
  restat = 1

build src/milkyplay/package: phony src/milkyplay/CMakeFiles/package.util


#############################################
# Utility command for package_source

build src/milkyplay/CMakeFiles/package_source.util: CUSTOM_COMMAND
  COMMAND = cd /work/MilkyTrackerNX2/build_nx2 && /usr/bin/cpack --config ./CPackSourceConfig.cmake /work/MilkyTrackerNX2/build_nx2/CPackSourceConfig.cmake
  DESC = Run CPack packaging tool for source...
  pool = console
  restat = 1

build src/milkyplay/package_source: phony src/milkyplay/CMakeFiles/package_source.util


