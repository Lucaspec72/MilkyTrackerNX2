build src/milkyplay/CMakeFiles/install.util: CUSTOM_COMMAND src/milkyplay/all
  COMMAND = cd /work/MilkyTrackerNX2/build_nx2/src/milkyplay && /usr/bin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build src/milkyplay/install: phony src/milkyplay/CMakeFiles/install.util


#############################################
